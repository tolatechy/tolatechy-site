---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import ToolLogo from '../components/ToolLogo.astro';
import { site } from '../site';

const facts = [
  { icon: 'MapPin', label: 'Based in', value: site.location },
  { icon: 'GraduationCap', label: 'Trained in', value: 'Statistics' },
  { icon: 'Languages', label: 'Researching', value: 'African-language NLP' },
  { icon: 'BookOpenCheck', label: 'Supporting', value: 'UK university students' },
] as const;

const timeline = [
  { when: 'Now', title: 'MSc, Data and Information Science', where: 'University of Ibadan · in progress', icon: 'GraduationCap' },
  { when: '2023 – 2026', title: 'Machine Learning Engineer', where: 'TechSTEPS Limited, Lagos', icon: 'Briefcase' },
  { when: '2021 – 2023', title: 'Data Scientist', where: 'Armstrong Global Concepts LLC, Austin, Texas', icon: 'Briefcase' },
  { when: '2021', title: 'BSc, Statistics', where: 'University of Ibadan', icon: 'GraduationCap' },
] as const;

const skills = [
  { icon: 'Code', group: 'Languages', items: ['Python', 'R', 'SQL'] },
  { icon: 'BrainCircuit', group: 'Machine learning', items: ['scikit-learn', 'TensorFlow', 'Keras', 'PyTorch', 'XGBoost', 'SHAP'] },
  { icon: 'Languages', group: 'NLP', items: ['NLTK', 'spaCy', 'Transformer fine-tuning'] },
  { icon: 'Sigma', group: 'Statistics', items: ['Hypothesis testing', 'A/B testing', 'Regression', 'Inference'] },
  { icon: 'ChartColumn', group: 'Data and reporting', items: ['pandas', 'NumPy', 'SciPy', 'Power BI', 'Tableau', 'Excel'] },
  { icon: 'Cloud', group: 'Deployment and cloud', items: ['Flask', 'Streamlit', 'FastAPI', 'AWS', 'Azure'] },
] as const;

const logos = ['siPython', 'siR', 'siTensorflow', 'siPytorch', 'siScikitlearn', 'siPandas', 'siJupyter', 'siSpacy'] as const;
---

<Base
  title="About Ibraheem Obanla | Data Scientist & Research Writer"
  description="Ibraheem Obanla is a statistics-trained data scientist and research writer in Lagos, Nigeria, working in machine learning, NLP research and academic support for students."
>
  <PageHeader
    eyebrow="About"
    title="Hi, I'm Ibraheem."
    lead="A data scientist and research writer in Lagos, trained in statistics. I work where data, research and writing meet."
  />

  <!-- Facts stage (the owner's photo will go here) -->
  <section class="container-site">
    <div class="stage relative isolate overflow-hidden p-5 sm:p-10">
      <div aria-hidden="true" class="absolute -top-32 -left-20 -z-10 size-96 rounded-full bg-primary-soft blur-3xl"></div>
      <div aria-hidden="true" class="absolute -right-20 -bottom-32 -z-10 size-96 rounded-full bg-[#fbefd5] blur-3xl"></div>
      <dl class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          facts.map((f, i) => (
            <div data-reveal style={`--d: ${i * 80}ms`} class="rounded-2xl bg-white p-5">
              <dt class="flex items-center gap-2 text-sm text-muted">
                <Icon name={f.icon} class="size-4" />
                {f.label}
              </dt>
              <dd class="mt-2 text-xl font-semibold tracking-tight">{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="mt-8 flex flex-wrap justify-center gap-3" aria-label="Tools I use">
        {logos.map((t) => <li><ToolLogo slug={t} class="size-11" /></li>)}
      </ul>
    </div>
  </section>

  <!-- Story -->
  <section class="container-site grid gap-12 py-20 sm:py-28 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:gap-20">
    <div data-reveal class="prose-site max-w-[40rem] text-lead text-muted">
      <p>
        <span class="font-medium text-ink">I studied statistics at the University of Ibadan,</span> and I'm now completing
        an MSc in Data and Information Science there.
      </p>
      <p>
        I worked as a data scientist for Armstrong Global Concepts in Austin, Texas, then as a machine learning engineer at
        TechSTEPS in Lagos, building and deploying models for customer retention and risk, and the reporting around them.
      </p>
      <p>
        My research is in NLP for low-resource African languages, with a focus on Yorùbá, and I co-authored a preprint on
        deep learning for early Parkinson's disease detection.
      </p>
      <p>
        I also support students with their research and writing, especially Nigerians meeting UK academic conventions for
        the first time. The work always stays their own.
      </p>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-28 lg:self-start">
      <div data-reveal class="stage p-6">
        <p class="font-semibold">My resume</p>
        <div class="mt-4 grid gap-2">
          <a class="btn btn-secondary justify-between" href={site.resumePdf}>PDF <Icon name="Download" class="size-4" /></a>
          <a class="btn btn-secondary justify-between" href={site.resumeDocx}>Word <Icon name="Download" class="size-4" /></a>
        </div>
      </div>
      <div data-reveal class="rounded-[var(--radius-stage)] bg-ink p-6 text-paper">
        <p class="text-xl font-semibold tracking-tight">Let's work together.</p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={site.hire} class="btn btn-sm bg-paper text-ink hover:bg-stage">Hire me</a>
          <a href={site.whatsapp} class="btn btn-sm border border-paper/25 text-paper hover:border-paper">WhatsApp</a>
        </div>
      </div>
    </aside>
  </section>

  <!-- Timeline -->
  <section class="border-t border-line py-20 sm:py-28" aria-labelledby="journey-heading">
    <div class="container-site">
      <h2 id="journey-heading" data-reveal class="text-center text-h2 font-bold">Education and experience.</h2>
      <ol class="mt-14 grid gap-4 md:grid-cols-4">
        {
          timeline.map((t, i) => (
            <li data-reveal style={`--d: ${i * 100}ms`} class="stage p-6">
              <span class:list={['grid size-11 place-items-center rounded-full', i === 0 ? 'bg-ink text-paper' : 'bg-white text-ink']}>
                <Icon name={t.icon} class="size-5" />
              </span>
              <p class="mt-6 text-sm text-muted tabular-nums">{t.when}</p>
              <p class="mt-1 font-semibold">{t.title}</p>
              <p class="mt-1 text-sm text-muted">{t.where}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Skills -->
  <section class="container-site pb-24 sm:pb-32" aria-labelledby="skills-heading">
    <h2 id="skills-heading" data-reveal class="text-center text-h2 font-bold">Skills and tools.</h2>
    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((s, i) => (
          <li data-reveal style={`--d: ${(i % 3) * 90}ms`} class="panel panel-hover p-6">
            <span class="icon-chip"><Icon name={s.icon} /></span>
            <h3 class="mt-4 font-semibold">{s.group}</h3>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {s.items.map((item) => <li class="rounded-full bg-stage px-2.5 py-0.5 text-sm">{item}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
