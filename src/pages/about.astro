---
import Base from '../layouts/Base.astro';
import { site } from '../site';

const skills = [
  { group: 'Languages', items: 'Python, R, SQL' },
  { group: 'Machine learning', items: 'scikit-learn, TensorFlow and Keras, PyTorch, XGBoost, SHAP' },
  { group: 'Natural language processing', items: 'NLTK, spaCy, fine-tuning transformer models' },
  { group: 'Statistics', items: 'Hypothesis testing, A/B testing, regression modelling, statistical inference' },
  { group: 'Data and reporting', items: 'pandas, NumPy, SciPy, Power BI, Tableau, Excel' },
  { group: 'Deployment and cloud', items: 'Flask, Streamlit, FastAPI, AWS (SageMaker, EC2, S3), Azure' },
];

const education = [
  { degree: 'MSc, Data and Information Science', school: 'University of Ibadan', when: 'In progress' },
  { degree: 'BSc, Statistics', school: 'University of Ibadan', when: '2021' },
];
---

<Base
  title="About Ibraheem Obanla | Data Scientist & Research Writer"
  description="Ibraheem Obanla is a statistics-trained data scientist and research writer in Lagos, Nigeria, working in machine learning, NLP research and academic support for students."
>
  <article class="container-site grid gap-14 py-16 sm:py-20 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:gap-20 lg:py-24">
    <div>
      <p class="eyebrow">About</p>
      <h1 class="mt-4 text-display font-semibold">About me</h1>

      <div class="prose-site mt-10 max-w-[40rem] text-lead">
        <p>
          I'm Ibraheem Obanla, a data scientist and research writer based in Lagos, Nigeria. My training
          is in statistics: I studied for a BSc in Statistics at the University of Ibadan, and I'm now
          completing an MSc in Data and Information Science there.
        </p>
      </div>

      <div class="prose-site mt-6 max-w-[40rem] text-muted">
        <p>
          I worked as a data scientist for Armstrong Global Concepts, a company based in Austin, Texas, from
          2021 to 2023, and then as a machine learning engineer at TechSTEPS Limited in Lagos from 2023 to
          2026. Across both roles I built and deployed predictive models for customer retention and risk,
          automated reporting with Power BI and SQL, and put data quality checks in place so the numbers on
          business dashboards could be relied on.
        </p>
        <p>
          My research is in natural language processing for low-resource African languages, with a focus on
          Yorùbá. I'm interested both in the models and in the data underneath them: how existing language
          datasets are documented and funded, and how classical machine learning compares with transformer
          models on real, messy social media text. I'm also a co-author of a preprint on attention-based deep
          learning for early detection of Parkinson's disease.
        </p>
        <p>
          Alongside this, I support students with their research and writing. Many are Nigerians who have
          moved to the UK for postgraduate study and are meeting UK academic conventions for the first time.
          I help them understand what's expected, from referencing and literature reviews to dissertation
          structure and statistical analysis, while the work stays their own.
        </p>
      </div>

      <h2 class="mt-16 text-h2 font-semibold">Skills and tools</h2>
      <dl class="mt-6 border-t-2 border-ink">
        {
          skills.map((s) => (
            <div class="grid gap-1 border-b border-line py-4 sm:grid-cols-[14rem_1fr] sm:gap-6">
              <dt class="font-semibold">{s.group}</dt>
              <dd class="text-muted">{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <aside class="space-y-12 lg:pt-28">
      <section aria-labelledby="edu-heading">
        <h2 id="edu-heading" class="eyebrow">Education</h2>
        <ul class="mt-4 border-t-2 border-ink">
          {
            education.map((e) => (
              <li class="border-b border-line py-4">
                <p class="font-semibold">{e.degree}</p>
                <p class="text-[0.9375rem] text-muted">
                  {e.school} · {e.when}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="resume-heading">
        <h2 id="resume-heading" class="eyebrow">Resume</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <a class="btn btn-secondary" href={site.resumePdf}>Download PDF</a>
          <a class="btn btn-secondary" href={site.resumeDocx}>Download Word</a>
        </div>
      </section>

      <section class="rounded-[var(--radius-panel)] bg-sand p-6" aria-labelledby="talk-heading">
        <h2 id="talk-heading" class="text-h3 font-semibold">Get in touch</h2>
        <p class="mt-2 text-muted">For academic support, research collaboration or data science work.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Contact me</a>
          <a href={site.whatsapp} class="btn btn-secondary">WhatsApp</a>
        </div>
      </section>
    </aside>
  </article>
</Base>
