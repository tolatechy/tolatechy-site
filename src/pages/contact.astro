---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';

const channels = [
  { icon: 'Mail', label: 'Email', href: `mailto:${site.email}`, text: site.email, note: 'Best for quotes and anything with attachments' },
  { icon: 'MessageCircle', label: 'WhatsApp', href: site.whatsapp, text: 'Message me on WhatsApp', note: 'Quick questions' },
  { icon: 'Briefcase', label: 'LinkedIn', href: site.linkedin, text: 'View my LinkedIn profile', note: 'Professional enquiries' },
  { icon: 'FolderGit2', label: 'GitHub', href: site.github, text: 'github.com/tolatechy', note: 'Code and projects' },
] as const;

const quoteChecklist = [
  'Your university, course and level (undergraduate, Master’s or PhD)',
  'The kind of help you need, e.g. referencing, editing, dissertation planning or data analysis',
  'The referencing style your department uses',
  'Your deadline',
  'Roughly how long the work is, if it’s a document',
];
---

<Base
  title="Contact Ibraheem Obanla | Request a Quote"
  description="Contact Ibraheem Obanla for a quote on dissertation, referencing, editing and data analysis support, research collaboration, or data science work."
>
  <PageHeader
    eyebrow="Contact"
    title="Get in touch"
    lead="For academic support, research collaboration or data science work. Email is best for quotes."
  />

  <section class="container-site grid gap-10 py-16 sm:py-20 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-14">
    <ul class="grid gap-4 sm:grid-cols-2 lg:self-start">
      {
        channels.map((c, i) => (
          <li data-reveal style={`--d: ${i * 80}ms`}>
            <a href={c.href} class="panel panel-hover group flex h-full flex-col p-6 no-underline">
              <span class="icon-chip transition-colors group-hover:bg-primary group-hover:text-paper">
                <Icon name={c.icon} />
              </span>
              <span class="mt-5 font-semibold text-ink">{c.label}</span>
              <span class="mt-1 text-[0.9375rem] font-medium break-all text-primary">{c.text}</span>
              <span class="mt-auto pt-3 text-sm text-muted">{c.note}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <aside
      data-reveal
      class="relative isolate self-start overflow-hidden rounded-[var(--radius-panel)] bg-primary-deep p-7 text-paper sm:p-9"
    >
      <div aria-hidden="true" class="dot-grid-light absolute inset-0 -z-10"></div>
      <div aria-hidden="true" class="absolute -right-20 -bottom-20 -z-10 size-64 rounded-full bg-primary opacity-60 blur-3xl"></div>
      <h2 class="text-h3 font-semibold">Requesting a quote for academic work</h2>
      <p class="mt-2 text-paper/75">Including these details helps me give you an accurate quote quickly:</p>
      <ul class="mt-6 space-y-3.5">
        {
          quoteChecklist.map((item) => (
            <li class="flex gap-3">
              <span class="mt-0.5 shrink-0 text-gold"><Icon name="CircleCheck" class="size-5" /></span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <a
        class="btn mt-8 w-full bg-paper text-ink hover:bg-gold sm:w-auto"
        href={`mailto:${site.email}?subject=${encodeURIComponent('Quote request')}`}
      >
        <Icon name="Mail" class="size-4" /> Email a quote request
      </a>
    </aside>
  </section>
</Base>
