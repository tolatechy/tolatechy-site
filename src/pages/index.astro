---
import Base from '../layouts/Base.astro';

const links = [
  { label: 'Email', href: 'mailto:ibraheemobanla44@gmail.com', text: 'ibraheemobanla44@gmail.com' },
  { label: 'WhatsApp', href: 'https://wa.me/2349020660127', text: 'Message me on WhatsApp' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/ibraheemobanla', text: 'linkedin.com/in/ibraheemobanla' },
  { label: 'GitHub', href: 'https://github.com/tolatechy', text: 'github.com/tolatechy' },
];
---

<Base
  title="Ibraheem Obanla — Data Scientist & Research Writer"
  description="Ibraheem Obanla is a data scientist and research writer in Lagos, Nigeria, offering machine learning work, NLP research and academic support for students at UK universities."
>
  <main class="mx-auto max-w-2xl px-5 py-16 sm:px-8 sm:py-24">
    <p class="text-sm font-medium tracking-wide text-muted uppercase">Lagos, Nigeria</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Ibraheem Obanla</h1>
    <p class="mt-2 text-xl text-muted">Data Scientist &amp; Research Writer</p>

    <div class="mt-10 space-y-4 text-lg leading-relaxed">
      <p>
        I build machine learning models for businesses, carry out research in natural language
        processing, and help students at UK universities with referencing, editing, dissertations
        and data analysis.
      </p>
      <p>The full site is on its way. In the meantime, you can reach me here.</p>
    </div>

    <dl class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
      {links.map((l) => (
        <div class="flex flex-col gap-1 py-4 sm:flex-row sm:gap-6">
          <dt class="w-28 shrink-0 text-sm font-medium text-muted">{l.label}</dt>
          <dd>
            <a
              class="text-accent underline decoration-accent/30 underline-offset-4 hover:decoration-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              href={l.href}
            >
              {l.text}
            </a>
          </dd>
        </div>
      ))}
    </dl>

    <p class="mt-10">
      <a
        class="inline-block rounded-md bg-ink px-5 py-3 font-medium text-paper hover:bg-ink/85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        href="/resume/Ibraheem_Obanla_Resume.pdf"
      >
        Download my resume (PDF)
      </a>
    </p>

    <footer class="mt-20 text-sm text-muted">© {new Date().getFullYear()} Ibraheem Obanla</footer>
  </main>
</Base>
