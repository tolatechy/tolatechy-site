---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import HeroVisual from '../components/HeroVisual.astro';
import CitationCard from '../components/CitationCard.astro';
import ToolLogo from '../components/ToolLogo.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
import heroPhoto from '../assets/hero/analytics-screen.jpg';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured && p.data.image)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({ ...p.data, image: p.data.image!, imageAlt: `Chart from the ${p.data.title} notebook` }));

const tools = [
  'siPython', 'siR', 'siTensorflow', 'siPytorch', 'siScikitlearn', 'siPandas', 'siNumpy',
  'siJupyter', 'siKeras', 'siStreamlit', 'siFlask', 'siFastapi', 'siSpacy', 'siGit',
] as const;
// Positions for the floating logo cloud on wide screens (percent of the area).
const spots = [
  [6, 10], [24, 2], [44, 14], [66, 4], [86, 12], [94, 42], [80, 72],
  [60, 92], [36, 90], [14, 74], [3, 46], [78, 32], [20, 36], [96, 80],
];

const experience = [
  { role: 'Machine Learning Engineer', org: 'TechSTEPS Limited', dates: '2023–2026' },
  { role: 'Data Scientist', org: 'Armstrong Global Concepts', dates: '2021–2023' },
];

const services = [
  { icon: 'Quote', title: 'Referencing', text: 'Harvard, APA, Chicago, MLA, OSCOLA and more' },
  { icon: 'PenLine', title: 'Editing and proofreading', text: 'Clarity, structure and academic tone' },
  { icon: 'Map', title: 'Dissertation planning', text: 'Questions, chapters and timelines' },
  { icon: 'Library', title: 'Literature reviews', text: 'Organising and critiquing sources' },
  { icon: 'ChartColumn', title: 'Statistics and analysis', text: 'Methods, R or Python, reporting' },
] as const;

const researchIcon: Record<string, 'HeartPulse' | 'Languages' | 'Database'> = {
  'Machine learning in health': 'HeartPulse',
  'Natural language processing': 'Languages',
  'Language data and policy': 'Database',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: Astro.site?.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Lagos', addressCountry: 'NG' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Ibadan' },
  sameAs: [site.linkedin, site.github],
  knowsAbout: [
    'Data science',
    'Machine learning',
    'Natural language processing',
    'Academic writing',
    'Referencing styles',
    'Dissertation support',
    'Statistics',
  ],
};
---

<Base
  title="Ibraheem Obanla | Data Scientist & Research Writer"
  description="Data scientist and research writer based in Lagos, Nigeria, available for remote work worldwide. Machine learning models, NLP research, and dissertation, referencing and editing support for students at UK universities."
  jsonLd={jsonLd}
>
  <!-- ───────────── Hero: photo underlay with dark shade ───────────── -->
  <section class="relative isolate mx-2 -mt-[4.25rem] overflow-hidden rounded-b-[2rem] bg-[#07110f] sm:mx-3 sm:-mt-[4.75rem] sm:rounded-b-[2.5rem]">
    <Image
      src={heroPhoto}
      alt=""
      widths={[800, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover object-[70%_center] opacity-90"
    />
    <!-- shade: darkens the photo so white text reads clearly -->
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[#07110f]/75"></div>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-linear-to-b from-[#07110f]/60 via-transparent to-[#07110f]"></div>
    <div aria-hidden="true" class="absolute -top-40 left-1/2 -z-10 size-[44rem] -translate-x-1/2 rounded-full bg-primary/35 blur-3xl"></div>

    <div class="container-site pt-36 pb-48 text-center text-paper sm:pt-44 sm:pb-64 lg:pt-48 lg:pb-72">
      <p class="enter inline-flex items-center gap-2 rounded-full border border-paper/15 bg-paper/10 px-3.5 py-1.5 text-sm text-paper/80 backdrop-blur">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-[#5fe0c4] opacity-60 motion-reduce:hidden"></span>
          <span class="relative inline-flex size-2 rounded-full bg-[#5fe0c4]"></span>
        </span>
        <span class="sm:hidden">Available for remote work worldwide</span>
        <span class="hidden sm:inline">Available for remote data science work · Worldwide</span>
      </p>
      <h1 class="enter mx-auto mt-6 max-w-[16ch] text-hero font-bold" style="--d: 80ms">
        Data Scientist and Research Writer.
      </h1>
      <p class="enter mx-auto mt-6 max-w-[34rem] text-lead text-paper/75" style="--d: 160ms">
        I build machine learning models. I also research NLP for African languages, and I help students get their dissertations over the line.
      </p>
      <div class="enter mt-8 flex flex-wrap justify-center gap-2.5" style="--d: 240ms">
        <a href={site.hire} class="btn bg-paper text-ink hover:bg-stage">Hire me</a>
        <a href="#work" class="btn border border-paper/25 text-paper backdrop-blur hover:bg-paper/10">
          View my work <Icon name="ArrowDown" class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Notebook + citation visual, overlapping the bottom of the hero -->
  <div class="relative z-10 container-site -mt-32 sm:-mt-48 lg:-mt-56">
    <HeroVisual />
  </div>

  <!-- ───────────── Tools and numbers ───────────── -->
  <section aria-label="Tools and experience" class="container-site py-20 sm:py-28">
    <div class="relative mx-auto max-w-[64rem]">
      <!-- floating logo cloud (wide screens) -->
      <div aria-hidden="true" class="absolute inset-0 hidden lg:block">
        {
          tools.map((t, i) => (
            <div
              class:list={['absolute -translate-x-1/2 -translate-y-1/2', ['float-a', 'float-b', 'float-c'][i % 3]]}
              style={`left:${spots[i][0]}%; top:${spots[i][1]}%`}
            >
              <ToolLogo slug={t} class={i % 4 === 0 ? 'size-14' : 'size-12'} />
            </div>
          ))
        }
      </div>

      <div data-reveal class="relative py-4 text-center lg:py-28">
        <p class="font-medium">Five years in data science and research</p>
        <p class="mt-4 text-[clamp(2.25rem,1.3rem+3.6vw,4rem)] leading-[1.08] font-bold tracking-[-0.04em] text-ink/25">
          <span class="text-ink"><span data-count="100">100</span>+ projects</span><br />
          <span class="text-ink/45">Ongoing research</span><br />
          <span><span data-count="8">8</span>+ citation styles</span>
        </p>
      </div>

      <!-- logo row (phones and tablets) -->
      <ul class="mt-10 flex flex-wrap justify-center gap-3 lg:hidden" aria-label="Tools I use">
        {tools.map((t) => <li><ToolLogo slug={t} class="size-11" /></li>)}
      </ul>
    </div>
  </section>

  <!-- ───────────── Data science ───────────── -->
  <section id="work" class="scroll-mt-24 container-site pb-24 sm:pb-32" aria-labelledby="ds-heading">
    <div data-reveal class="mx-auto max-w-[44rem] text-center">
      <p class="eyebrow">Data science</p>
      <h2 id="ds-heading" class="mt-3 text-h2 font-bold">Models that businesses actually use.</h2>
      <p class="mx-auto mt-5 max-w-[32rem] text-lead text-muted">
        Mostly credit risk, customer retention and security. I take a project from a messy first dataset to a model people can rely on.
      </p>
      <ul class="mt-7 flex flex-wrap justify-center gap-2">
        {
          experience.map((e) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-line px-3.5 py-1.5 text-sm">
              <Icon name="Briefcase" class="size-3.5 shrink-0 text-muted" />
              <span class="font-medium whitespace-nowrap">{e.role}</span>
              <span class="hidden text-muted sm:inline">· {e.org}</span>
              <span class="text-muted whitespace-nowrap">· {e.dates}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="mt-14 grid gap-x-5 gap-y-12 md:grid-cols-2">
      {
        featuredProjects.map((p, i) => (
          <li data-reveal style={`--d: ${(i % 2) * 120}ms`}>
            <a href={p.repo} class="group block no-underline">
              <div class="stage relative overflow-hidden p-5 pb-0 sm:p-8 sm:pb-0">
                <div class="window translate-y-2 transition-transform duration-500 group-hover:translate-y-0">
                  <div class="window-bar">
                    <i></i><i></i><i></i>
                    <span class="ml-2 truncate">{p.repo.split('/').pop()}.ipynb</span>
                  </div>
                  <div class="aspect-[16/10] overflow-hidden bg-white p-3">
                    <Image
                      src={p.image}
                      alt={p.imageAlt}
                      widths={[480, 720, 960]}
                      sizes="(min-width: 768px) 560px, 100vw"
                      class="h-full w-full object-contain object-top"
                    />
                  </div>
                </div>
              </div>
              <div class="mt-5 flex items-start justify-between gap-4 px-1">
                <div>
                  <p class="text-sm text-muted">{p.area}</p>
                  <h3 class="mt-1 text-h3 font-semibold text-ink">{p.title}</h3>
                  <p class="mt-1.5 line-clamp-2 text-muted">{p.summary}</p>
                </div>
                <span class="mt-1 grid size-10 shrink-0 place-items-center rounded-full bg-stage text-ink transition-colors group-hover:bg-ink group-hover:text-paper">
                  <Icon name="ArrowUpRight" class="size-4" />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <div data-reveal class="mt-14 flex flex-wrap justify-center gap-2.5">
      <a href={site.hire} class="btn btn-primary">Hire me</a>
      <a href="/projects" class="btn btn-secondary">See all projects <Icon name="ArrowRight" class="size-4" /></a>
    </div>
  </section>

  <!-- ───────────── Research ───────────── -->
  <section id="research" class="border-t border-line py-24 sm:py-32" aria-labelledby="research-heading">
    <div class="container-site">
      <div data-reveal class="mx-auto max-w-[44rem] text-center">
        <p class="eyebrow">Research</p>
        <h2 id="research-heading" class="mt-3 text-h2 font-bold">What I'm researching right now.</h2>
        <p class="mx-auto mt-5 max-w-[32rem] text-lead text-muted">
          Mostly NLP for African languages, starting with Yorùbá. It has millions of speakers and still very little good data.
        </p>
      </div>

      <ul class="mt-14 grid gap-5 md:grid-cols-3">
        {
          research.map(({ data }, i) => (
            <li data-reveal style={`--d: ${i * 110}ms`} class="flex flex-col">
              <div class="stage relative grid aspect-[4/3] place-items-center overflow-hidden">
                <div aria-hidden="true" class:list={[
                  'absolute size-48 rounded-full blur-2xl',
                  data.status === 'preprint' && 'bg-status-preprint-bg',
                  data.status === 'under-review' && 'bg-status-review-bg',
                  data.status === 'in-progress' && 'bg-status-progress-bg',
                ]} />
                <span class="relative grid size-20 place-items-center rounded-[1.5rem] bg-white shadow-[0_20px_40px_-20px_rgb(17_17_19/0.45)]">
                  <Icon name={researchIcon[data.area] ?? 'FlaskConical'} class="size-9" strokeWidth={1.5} />
                </span>
                <span class="absolute top-4 left-4"><StatusBadge status={data.status} /></span>
              </div>
              <div class="mt-5 px-1">
                <p class="text-sm text-muted">{data.area} · {data.year}</p>
                <h3 class="mt-1 text-h3 font-semibold">{data.title}</h3>
                <p class="mt-1.5 text-muted">{data.highlight}</p>
                {data.link && (
                  <a class="link mt-3 inline-flex items-center gap-1 text-[0.9375rem] font-medium" href={data.link}>
                    Read on {data.venue} <Icon name="ArrowUpRight" class="size-4" />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      <div data-reveal class="mt-14 flex justify-center">
        <a href="/research" class="btn btn-secondary">More about my research <Icon name="ArrowRight" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- ───────────── Writing support ───────────── -->
  <section id="support" class="container-site pb-24 sm:pb-32" aria-labelledby="support-heading">
    <div class="stage relative isolate overflow-hidden px-5 py-14 sm:px-12 sm:py-20">
      <div aria-hidden="true" class="absolute -top-40 right-0 -z-10 size-[30rem] rounded-full bg-primary-soft blur-3xl"></div>

      <div data-reveal class="mx-auto max-w-[44rem] text-center">
        <p class="eyebrow">Research &amp; writing support</p>
        <h2 id="support-heading" class="mt-3 text-h2 font-bold">Studying at a UK university? I can help.</h2>
        <p class="mx-auto mt-5 max-w-[34rem] text-lead text-muted">
          A lot of the students I help are Nigerians on their first UK course. The rules are different there, and they're rarely explained properly.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-[60rem] gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-center">
        <div data-reveal><CitationCard /></div>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          {
            services.map((s, i) => (
              <li data-reveal style={`--d: ${i * 70}ms`} class="flex items-center gap-4 rounded-2xl bg-white p-3.5 pr-5 shadow-[0_1px_0_rgb(17_17_19/0.04)]">
                <span class="icon-chip size-11 shrink-0"><Icon name={s.icon} /></span>
                <span>
                  <span class="block font-semibold">{s.title}</span>
                  <span class="block text-sm text-muted">{s.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal class="mt-12 flex flex-wrap justify-center gap-2.5">
        <a href={site.quote} class="btn btn-primary">Request a quote</a>
        <a href="/research-support" class="btn btn-secondary">See all services <Icon name="ArrowRight" class="size-4" /></a>
      </div>
    </div>
  </section>

  <!-- ───────────── Closing ───────────── -->
  <section class="container-site pb-24 text-center sm:pb-32">
    <div data-reveal>
      <h2 class="mx-auto max-w-[16ch] text-display font-bold">Got something in mind?</h2>
      <p class="mx-auto mt-5 max-w-[30rem] text-lead text-muted">A data project, a research idea, or a dissertation that needs a second pair of eyes. Send me a message.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        <a href={site.hire} class="btn btn-primary">Hire me</a>
        <a href={site.quote} class="btn btn-secondary">Request a quote</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Count numbers up from zero the first time they scroll into view.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          const el = e.target as HTMLElement;
          const end = Number(el.dataset.count);
          const t0 = performance.now();
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / 1200);
            el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(tick);
          };
          el.textContent = '0';
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );
    counters.forEach((c) => io.observe(c));
  }
</script>
