---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured && p.data.image);
const rest = all.filter((p) => !featured.includes(p));

const areaIcon: Record<string, string> = {
  'Finance & credit risk': 'Landmark',
  Security: 'ShieldCheck',
  'Customer & people analytics': 'Users',
  'NLP & text': 'Languages',
  'Computer vision': 'ScanEye',
  'Recommender systems': 'Clapperboard',
  'Regression & forecasting': 'TrendingUp',
  'Reinforcement learning': 'Grid3x3',
  Tools: 'Wrench',
};
const areas = [...new Set(all.map((p) => p.data.area))];
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Base
  title="Data Science & Machine Learning Projects | Ibraheem Obanla"
  description="Machine learning projects by Ibraheem Obanla: credit risk, intrusion detection, churn and attrition, NLP, computer vision and recommender systems, with code on GitHub."
>
  <PageHeader
    eyebrow="Projects"
    title="Data science projects."
    lead="A selection of my work across credit risk, security, customer analytics, NLP and more, with code and notebooks on GitHub."
  >
    <div class="enter mt-8 flex flex-wrap justify-center gap-2.5" style="--d: 240ms">
      <a href={site.hire} class="btn btn-primary">Hire me</a>
      <a href={site.github} class="btn btn-secondary">GitHub profile <Icon name="ArrowUpRight" class="size-4" /></a>
    </div>
  </PageHeader>

  <!-- Filters (shown only when JavaScript runs) -->
  <div class="container-site">
    <div data-filters hidden class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-2 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:justify-center sm:overflow-visible sm:px-0" role="group" aria-label="Filter projects by area">
      <button type="button" data-filter="all" aria-pressed="true" class="filter-btn">All <span>{all.length}</span></button>
      {
        areas.map((a) => (
          <button type="button" data-filter={slug(a)} aria-pressed="false" class="filter-btn">
            {a} <span>{all.filter((p) => p.data.area === a).length}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Featured -->
  <section class="container-site pt-12" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="sr-only">Featured projects</h2>
    <ul class="grid gap-x-5 gap-y-12 md:grid-cols-2">
      {
        featured.map(({ data }, i) => (
          <li data-reveal data-area={slug(data.area)} style={`--d: ${(i % 2) * 120}ms`}>
            <a href={data.repo} class="group block no-underline">
              <div class="stage relative overflow-hidden p-5 pb-0 sm:p-8 sm:pb-0">
                <span class="absolute top-4 left-4 z-10 rounded-full bg-white px-2.5 py-0.5 text-[0.8125rem] font-medium">Featured</span>
                <div class="window translate-y-2 transition-transform duration-500 group-hover:translate-y-0">
                  <div class="window-bar">
                    <i></i><i></i><i></i>
                    <span class="ml-2 truncate">{data.repo.split('/').pop()}.ipynb</span>
                  </div>
                  <div class="aspect-[16/10] overflow-hidden bg-white p-3">
                    <Image src={data.image!} alt={`Chart from the ${data.title} notebook`} widths={[480, 720, 960]} sizes="(min-width: 768px) 560px, 100vw" class="h-full w-full object-contain object-top" />
                  </div>
                </div>
              </div>
              <div class="mt-5 px-1">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-sm text-muted">{data.area}</p>
                    <h3 class="mt-1 text-h3 font-semibold text-ink">{data.title}</h3>
                  </div>
                  <span class="mt-1 grid size-10 shrink-0 place-items-center rounded-full bg-stage text-ink transition-colors group-hover:bg-ink group-hover:text-paper">
                    <Icon name="ArrowUpRight" class="size-4" />
                  </span>
                </div>
                <p class="mt-2 text-muted">{data.summary}</p>
                {data.result && (
                  <p class="mt-3 flex gap-2 text-[0.9375rem] text-ink">
                    <span class="mt-0.5 shrink-0 text-primary"><Icon name="Target" class="size-4" /></span>
                    {data.result}
                  </p>
                )}
                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {data.tags.map((t) => <li class="rounded-full bg-stage px-2.5 py-0.5 text-sm">{t}</li>)}
                </ul>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- All other projects -->
  <section class="container-site py-20 sm:py-24" aria-labelledby="more-heading">
    <h2 id="more-heading" data-reveal class="text-center text-h2 font-bold">More projects.</h2>
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        rest.map(({ data }, i) => (
          <li data-reveal data-area={slug(data.area)} style={`--d: ${(i % 3) * 80}ms`}>
            <a href={data.repo} class="panel panel-hover group flex h-full flex-col p-6 no-underline">
              <div class="flex items-center justify-between">
                <span class="icon-chip transition-colors group-hover:bg-ink group-hover:text-paper">
                  <Icon name={(areaIcon[data.area] ?? 'FlaskConical') as any} />
                </span>
                <Icon name="ArrowUpRight" class="size-4 text-muted transition-colors group-hover:text-ink" />
              </div>
              <p class="mt-5 text-sm text-muted">{data.area}</p>
              <h3 class="mt-1 font-semibold text-ink">{data.title}</h3>
              <p class="mt-1.5 text-[0.9375rem] text-muted">{data.summary}</p>
              {data.result && <p class="mt-3 text-[0.9375rem] font-medium text-ink">{data.result}</p>}
              <ul class="mt-auto flex flex-wrap gap-1.5 pt-4">
                {data.tags.map((t) => <li class="rounded-full bg-stage px-2.5 py-0.5 text-[0.8125rem]">{t}</li>)}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
    <p data-empty hidden class="mt-6 text-center text-muted">No other projects in this area. The featured ones are above.</p>

    <div data-reveal class="mt-14 flex flex-wrap justify-center gap-2.5">
      <a href={site.hire} class="btn btn-primary">Hire me</a>
      <a href={site.github} class="btn btn-secondary">All code on GitHub <Icon name="ArrowUpRight" class="size-4" /></a>
    </div>
  </section>
</Base>

<style>
  .filter-btn {
    flex-shrink: 0;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--color-stage);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-muted);
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }
  .filter-btn span {
    font-size: 0.8125rem;
    opacity: 0.6;
  }
  .filter-btn:hover {
    color: var(--color-ink);
  }
  .filter-btn[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  if (bar) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('li[data-area]')];
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const apply = (f: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      cards.forEach((c) => {
        c.hidden = f !== 'all' && c.dataset.area !== f;
        if (!c.hidden) c.classList.add('is-visible');
      });
      const restShown = cards.some((c) => !c.hidden && c.closest('section')?.getAttribute('aria-labelledby') === 'more-heading');
      if (empty) empty.hidden = restShown;
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
  }
</script>
