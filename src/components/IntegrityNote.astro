---
import Icon from './Icon.astro';
---

<div data-reveal class="flex flex-col gap-5 rounded-[var(--radius-stage)] bg-ink p-7 text-paper sm:flex-row sm:items-center sm:p-9">
  <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-paper/10"><Icon name="ShieldCheck" class="size-7" /></span>
  <div>
    <p class="text-xl font-semibold tracking-tight">The work you submit stays your own.</p>
    <p class="mt-1.5 max-w-[46rem] text-paper/70">
      I provide guidance, editing and feedback, not ghost-writing. That keeps you within your university's rules on
      academic integrity and proofreading.
    </p>
  </div>
</div>
