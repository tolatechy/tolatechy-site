---
// Centred banner at the top of inner pages: eyebrow pill, big title, short lead.
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="container-site pt-14 pb-12 text-center sm:pt-20 sm:pb-16">
  <p class="enter inline-flex items-center gap-2 rounded-full bg-stage px-3.5 py-1.5 text-sm text-muted">{eyebrow}</p>
  <h1 class="enter mx-auto mt-6 max-w-[16ch] text-display font-bold" style="--d: 80ms">{title}</h1>
  {lead && <p class="enter mx-auto mt-6 max-w-[36rem] text-lead text-muted" style="--d: 160ms">{lead}</p>}
  <slot />
</section>
