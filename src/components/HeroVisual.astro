---
// Hero "stage": a notebook window showing a real chart from the credit-risk project,
// the live citation card, a research status chip and floating tool logos.
import { Image } from 'astro:assets';
import CitationCard from './CitationCard.astro';
import ToolLogo from './ToolLogo.astro';
import Icon from './Icon.astro';
import creditRoc from '../assets/projects/credit-risk-roc.png';
---

<div class="stage relative isolate overflow-hidden px-4 pt-8 pb-6 sm:px-10 sm:pt-14 sm:pb-0 lg:px-16 lg:pt-16">
  <!-- soft colour wash -->
  <div aria-hidden="true" class="absolute -top-32 -left-24 -z-10 size-[28rem] rounded-full bg-primary-soft blur-3xl"></div>
  <div aria-hidden="true" class="absolute -right-24 -bottom-40 -z-10 size-[26rem] rounded-full bg-[#fbefd5] blur-3xl"></div>

  <!-- floating tool logos (tablet and up) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-0 hidden md:block">
    <div class="float-a absolute top-8 left-6 lg:left-10"><ToolLogo slug="siPython" class="size-14" /></div>
    <div class="float-b absolute right-8 bottom-16 lg:right-12"><ToolLogo slug="siPytorch" class="size-12" /></div>
    <div class="float-c absolute bottom-24 left-4 lg:left-8"><ToolLogo slug="siScikitlearn" class="size-12" /></div>
  </div>

  <div class="relative mx-auto grid max-w-[60rem] gap-5 md:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] md:items-start">
    <!-- notebook window -->
    <div class="window enter" style="--d: 300ms">
      <div class="window-bar">
        <i></i><i></i><i></i>
        <span class="ml-2">credit_risk.ipynb</span>
        <span class="ml-auto hidden items-center gap-1 sm:flex"><span class="size-1.5 rounded-full bg-primary"></span>Python 3</span>
      </div>
      <pre class="overflow-hidden border-b border-line bg-stage/60 px-4 py-3 font-mono text-[0.7rem] leading-relaxed whitespace-pre text-ink/80 [mask-image:linear-gradient(to_right,black_85%,transparent)]"><span class="text-muted">In [24]:</span> <span class="text-primary">for</span> name, model <span class="text-primary">in</span> models.items():
             fpr, tpr, _ = roc_curve(y_test, model.predict_proba(X_test)[:, 1])</pre>
      <div class="p-3 sm:p-5">
        <Image
          src={creditRoc}
          alt="ROC curves comparing four models, from the credit risk notebook"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 560px, 100vw"
          class="mx-auto w-full max-w-[30rem]"
          loading="eager"
        />
      </div>
    </div>

    <!-- citation card + status chip -->
    <div class="relative md:mt-24">
      <CitationCard class="enter" />
      <div class="enter mt-3 flex justify-center md:absolute md:-top-7 md:-right-6 md:mt-0" style="--d: 650ms">
        <div class="float-b flex items-center gap-2.5 rounded-full bg-white py-1.5 pr-4 pl-1.5 shadow-[0_14px_30px_-14px_rgb(17_17_19/0.45)]">
          <span class="grid size-8 place-items-center rounded-full bg-status-review-bg text-status-review"><Icon name="Languages" class="size-4" /></span>
          <span class="text-[0.8125rem] leading-tight">
            <span class="block font-medium">Yorùbá dataset audit</span>
            <span class="text-status-review">Under review</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
