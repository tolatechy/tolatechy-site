---
import { nav, site } from '../site';

const items = nav.filter((item) => item.ready);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === href || current.startsWith(href + '/');
---

<!-- Floating pill navigation -->
<header data-header class="sticky top-0 z-30 px-3 pt-3 sm:px-5 sm:pt-4">
  <div
    class="mx-auto flex max-w-[60rem] items-center justify-between gap-4 rounded-full border border-line bg-white/95 py-1.5 pr-1.5 pl-4 backdrop-blur-xl transition-shadow data-[scrolled]:shadow-[0_10px_30px_-18px_rgb(17_17_19/0.45)] sm:pl-5"
    data-bar
  >
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-ink no-underline">
      <span aria-hidden="true" class="grid size-7 place-items-center rounded-full bg-ink text-[0.6875rem] font-bold text-paper">IO</span>
      <span>{site.name}</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="rounded-full px-3.5 py-2 text-[0.9375rem] text-muted no-underline transition-colors hover:text-ink aria-[current=page]:bg-stage aria-[current=page]:text-ink"
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.hire} class="btn btn-primary btn-sm ml-2">Hire me</a>
    </nav>

    <!-- Phone navigation: native disclosure, no JavaScript needed -->
    <div class="flex items-center gap-1.5 md:hidden">
      <a href={site.hire} class="btn btn-primary btn-sm">Hire me</a>
      <details class="group">
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center rounded-full bg-stage [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg class="size-4 group-open:hidden" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 5h12M2 11h12"></path></svg>
          <svg class="hidden size-4 group-open:block" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path></svg>
        </summary>
        <nav
          aria-label="Main"
          class="absolute inset-x-3 top-[4.25rem] z-20 rounded-[1.25rem] border border-line bg-white p-2 shadow-xl"
        >
          <a href="/" class="block rounded-xl px-4 py-3 font-medium text-ink no-underline hover:bg-stage">Home</a>
          {
            items.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="block rounded-xl px-4 py-3 font-medium text-ink no-underline hover:bg-stage aria-[current=page]:bg-stage"
              >
                {item.label}
              </a>
            ))
          }
          <a href={site.quote} class="btn btn-secondary mt-2 w-full">Request a quote</a>
        </nav>
      </details>
    </div>
  </div>
</header>
