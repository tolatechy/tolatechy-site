---
import { nav, site } from '../site';

const items = nav.filter((item) => item.ready);
---

<footer class="mt-auto border-t border-line bg-paper">
  <div class="container-site grid gap-10 py-12 sm:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-semibold">{site.name}</p>
      <p class="mt-1 text-muted">{site.role}<br />{site.location}</p>
    </div>

    <div>
      <p class="eyebrow">Contact</p>
      <ul class="mt-3 space-y-2">
        <li><a class="link break-all" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="link" href={site.whatsapp}>WhatsApp</a></li>
        <li><a class="link" href={site.linkedin}>LinkedIn</a></li>
        <li><a class="link" href={site.github}>GitHub</a></li>
      </ul>
    </div>

    <div>
      <p class="eyebrow">Site</p>
      <ul class="mt-3 space-y-2">
        <li><a class="link" href="/">Home</a></li>
        {items.map((item) => <li><a class="link" href={item.href}>{item.label}</a></li>)}
        <li><a class="link" href={site.resumePdf}>Resume (PDF)</a></li>
      </ul>
    </div>
  </div>
  <div class="container-site pb-10 text-sm text-muted">
    © {new Date().getFullYear()} {site.name}
  </div>
</footer>
