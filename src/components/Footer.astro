---
import { nav, site } from '../site';

const items = nav.filter((item) => item.ready);
---

<footer class="mt-auto bg-ink text-paper">
  <div class="container-site grid gap-12 pt-16 pb-10 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <p class="text-2xl font-semibold tracking-tight">{site.name}</p>
      <a href={site.github} class="relative mt-1 inline-block text-paper/60 italic no-underline hover:text-paper">
        @{site.handle}<span aria-hidden="true" class="absolute -top-1 -right-2.5 text-[0.625rem] not-italic">™</span>
      </a>
      <p class="mt-2 text-paper/60">{site.role}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href={site.hire} class="btn btn-sm bg-paper text-ink hover:bg-stage">Hire me</a>
        <a href={site.quote} class="btn btn-sm border border-paper/25 text-paper hover:border-paper">Request a quote</a>
      </div>
    </div>

    <div>
      <p class="text-sm text-paper/50">Contact</p>
      <ul class="mt-4 space-y-2.5">
        <li><a class="break-all text-paper/90 no-underline hover:text-paper hover:underline" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="text-paper/90 no-underline hover:text-paper hover:underline" href={site.whatsapp}>WhatsApp</a></li>
        <li><a class="text-paper/90 no-underline hover:text-paper hover:underline" href={site.linkedin}>LinkedIn</a></li>
        <li><a class="text-paper/90 no-underline hover:text-paper hover:underline" href={site.github}>GitHub</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm text-paper/50">Site</p>
      <ul class="mt-4 space-y-2.5">
        <li><a class="text-paper/90 no-underline hover:text-paper hover:underline" href="/">Home</a></li>
        {items.map((item) => <li><a class="text-paper/90 no-underline hover:text-paper hover:underline" href={item.href}>{item.label}</a></li>)}
        <li><a class="text-paper/90 no-underline hover:text-paper hover:underline" href={site.resumePdf}>Resume (PDF)</a></li>
      </ul>
    </div>
  </div>
  <div class="container-site flex flex-wrap items-center justify-between gap-3 border-t border-paper/10 py-6 text-sm text-paper/50">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span class="flex gap-5">
      <a href="/terms" class="text-paper/60 no-underline hover:text-paper">Terms</a>
      <a href="/privacy" class="text-paper/60 no-underline hover:text-paper">Privacy</a>
    </span>
  </div>
</footer>
