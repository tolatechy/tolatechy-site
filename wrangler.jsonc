// Cloudflare Worker settings. The site is plain static files from `dist/`.
// `not_found_handling` makes unknown addresses show our 404 page instead of a blank error.
// `routes` attach the custom domains; Cloudflare creates their DNS records and HTTPS certificates.
{
  "name": "tolatechy",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "ibraheemobanla.com", "custom_domain": true },
    { "pattern": "www.ibraheemobanla.com", "custom_domain": true }
  ]
}
